{
  "manifest_version": 3,
  "name": "Atelier Browser",
  "version": "1.3.1",
  "minimum_chrome_version": "116",
  "description": "Lets your Atelier assistant, on this computer or your phone, read pages, and click or type once you confirm it here.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Atelier Browser",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://atelier.ciprari.ai/*",
        "http://localhost:8787/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}

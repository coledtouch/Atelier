{
  "name": "Atelier — Personal Studio",
  "short_name": "Atelier",
  "description": "Answers, code, images, video, ideas and apps — powered by NVIDIA build.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#0e0d0b",
  "theme_color": "#0e0d0b",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "/icons/atelier-v2-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/atelier-v2-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/atelier-v2-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Ask",
      "url": "/?mode=ask",
      "icons": [
        {
          "src": "/icons/atelier-v2-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Imagine an image",
      "url": "/?mode=image",
      "icons": [
        {
          "src": "/icons/atelier-v2-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Build an app",
      "url": "/?mode=build",
      "icons": [
        {
          "src": "/icons/atelier-v2-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}

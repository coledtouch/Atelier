{
  "name": "Atelier — Personal Studio",
  "short_name": "Atelier",
  "description": "Answers, code, images, video, ideas and apps — powered by NVIDIA build.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#0e0d0b",
  "theme_color": "#0e0d0b",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "/icons/atelier-v2-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/atelier-v2-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/atelier-v2-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Talk to Atelier",
      "short_name": "Talk",
      "description": "Open Atelier already listening",
      "url": "/?start=voice",
      "icons": [
        { "src": "/icons/shortcut-talk-96.png", "sizes": "96x96", "type": "image/png", "purpose": "any" },
        { "src": "/icons/shortcut-talk-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "/icons/shortcut-talk-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" }
      ]
    },
    {
      "name": "Ask Atelier",
      "short_name": "Ask",
      "description": "Type a question",
      "url": "/?start=ask",
      "icons": [
        { "src": "/icons/shortcut-ask-96.png", "sizes": "96x96", "type": "image/png", "purpose": "any" },
        { "src": "/icons/shortcut-ask-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "/icons/shortcut-ask-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" }
      ]
    },
    {
      "name": "Imagine an image",
      "short_name": "Imagine",
      "description": "Describe a picture to make",
      "url": "/?start=image",
      "icons": [
        { "src": "/icons/shortcut-image-96.png", "sizes": "96x96", "type": "image/png", "purpose": "any" },
        { "src": "/icons/shortcut-image-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "/icons/shortcut-image-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" }
      ]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "media", "accept": ["image/*", "video/*"] }
      ]
    }
  }
}

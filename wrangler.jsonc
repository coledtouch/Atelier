{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atelier",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  // Deploy guard: wrangler runs this before every deploy, version upload, dev and types (WRANGLER_COMMAND names which).
  // A deploy or upload goes ahead only from npm run deploy (scripts/ship.mjs, its clean worktree) or a confirmed
  // npm run deploy:raw; `npx wrangler deploy` anywhere else stops before uploading. dev and types always pass.
  "build": { "command": "node scripts/deploy-guard.mjs" },
  "routes": [{ "pattern": "atelier.ciprari.ai", "custom_domain": true }],
  // The custom domain is the only way in: no atelier.<account>.workers.dev hostname and no per-version preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // /share: the share target's fallback when no service worker answers the POST (src/worker.js; it never reads the body).
    "run_worker_first": ["/api/*", "/share"],
    "not_found_handling": "single-page-application"
  },
  // Profile + memory sync ("You" panel), guarded by APP_PASSCODE.
  "kv_namespaces": [{ "binding": "ATELIER_KV", "id": "069567aa1d9a426588b90757d49c6c71" }],
  // Remote browser relay: one Durable Object holds the extension's WebSocket.
  // Ledger: LinkedIn tester roster, sessions and spend meter (one "main" instance, SQLite; starts paused), plus the owner's
  // monthly video and image spend record (owner_spend; src/spend.js, Settings → Spending; no limits since v85).
  // Guard: the passcode lockout (src/guard.js; one "main" instance, SQLite): failures per network (IPv4 address, IPv6
  // /64), counted in one serialized step, and the global wrong-guess budget. Its own class so a flood of guesses never
  // queues in front of the Ledger. Migration v3 creates it on the first deploy that has it; from then on Cloudflare
  // refuses a rollback to any version before it (a Durable Object class change), so a problem is fixed forward.
  // Secrets (never vars): GUARD_SECRET (required; 32+ random characters) signs the owner's clearance cookie in the Worker
  // itself; GUARD_RELAX "1" is the operator's lever (README "Passcode guard"): it lifts the global seal and, if the Guard
  // is down, lets requests through on GUARD_LIMIT's per-network throttle alone.
  "durable_objects": { "bindings": [{ "name": "RELAY", "class_name": "Relay" }, { "name": "LEDGER", "class_name": "Ledger" }, { "name": "GUARD", "class_name": "Guard" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Relay"] }, { "tag": "v2", "new_sqlite_classes": ["Ledger"] }, { "tag": "v3", "new_sqlite_classes": ["Guard"] }],
  // Per-IP throttle on the public LinkedIn sign-in routes (/api/li/start, /api/li/callback), ahead of the Ledger.
  // Look up (src/lookup.js): LOOKUP_LIMIT per user ('owner' or t:<sub>; preview images count on <key>:img) and WIKI_LIMIT
  // for Atelier's calls to Wikimedia: testers share 'wikimedia' (API) and 'commons' (images); the owner has
  // 'wikimedia:owner' and 'commons:owner', so testers can never use up Look up for the owner.
  "ratelimits": [
    { "name": "LI_LIMIT", "namespace_id": "4711", "simple": { "limit": 20, "period": 60 } },
    { "name": "LOOKUP_LIMIT", "namespace_id": "4712", "simple": { "limit": 30, "period": 60 } },
    { "name": "WIKI_LIMIT", "namespace_id": "4713", "simple": { "limit": 120, "period": 60 } },
    // App error reports (POST /api/client-error, src/client-errors.js): 10 a minute per IP (an IPv6 address by its /64).
    // Public, since a start-up crash can come before the passcode; the Worker also caps each isolate at 30 a minute and
    // refuses versions that aren't deployed, and the Ledger keeps only 50, taking at most 20 new ones an hour.
    { "name": "ERR_LIMIT", "namespace_id": "4714", "simple": { "limit": 10, "period": 60 } },
    // Passcode requests that reach the Guard (src/guard.js passcodeGate, no valid clearance): 30 a minute per network (an
    // IPv6 address by its /64). Over it: the same 429 a lock gets, with nothing compared and no Durable Object call.
    { "name": "GUARD_LIMIT", "namespace_id": "4715", "simple": { "limit": 30, "period": 60 } },
    // A tester's thread-sync reads (src/tester/sync.js: the index, a thread, a blob, the trash list), per tester (syncr:<sub>):
    // 300 a minute. Their writes and missing-blob checks are on LI_LIMIT (sync:<sub>, syncm:<sub>). The owner's sync isn't.
    { "name": "SYNC_READ_LIMIT", "namespace_id": "4716", "simple": { "limit": 300, "period": 60 } }
  ],
  // Owner thread sync: private R2 bucket (threads as JSON docs, media and long text as SHA-256 blobs). Passcode only.
  // Create it once before deploying (owner approval): npx wrangler r2 bucket create atelier-sync. Never public.
  "r2_buckets": [{ "binding": "SYNC_BUCKET", "bucket_name": "atelier-sync" }],
  // SYNC_QUOTA_BYTES: thread-sync blob storage cap (50 GiB); above it new media uploads answer 507, nothing is deleted.
  // SYNC_DISABLED is a secret kill switch, never a var (wrangler secret put SYNC_DISABLED → every /api/sync route 503).
  // Canva app client ID (public - it appears in the sign-in URL). CANVA_CLIENT_SECRET is a Worker secret.
  // WIKI_CONTACT: the public contact in Atelier's Wikimedia User-Agent (the address on /privacy). LOOKUP_DISABLED "1"
  // turns Look up off (503 lookup_off; the app then hides it for the session).
  // RUNWAY_MAX_CREDITS (optional per-video Runway cap, src/runway.js; unset = none, the most one video costs is 2,040
  // credits): add it here or with `wrangler secret put` — a var set in the dashboard is wiped by the next deploy.
  // TESTERS_ENABLED: LinkedIn tester access (src/worker.js testersOn). "1" turns it on; "0" (or no var) keeps it off: the
  // sign-in routes /api/li/* answer 410, tester cookies are ignored and cleared, every tester route refuses, and the app
  // hides every tester surface. The tester code and the Ledger stay. Reopened in v90 at the owner's request (off in v85–v89).
  "vars": { "SYNC_QUOTA_BYTES": "53687091200", "CANVA_CLIENT_ID": "OC-AaD0HxvGYkj2", "WIKI_CONTACT": "cole@ciprari.ai", "LOOKUP_DISABLED": "0", "TESTERS_ENABLED": "1" },
  // Workers Logs keep our own console output, but not the automatic per-request invocation logs: those record full
  // request URLs, which can carry OAuth codes and invite codes.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
